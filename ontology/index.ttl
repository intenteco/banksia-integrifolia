rel:working a dcat:Dataset ;
    dct:isVersionOf qualia:banksia_integrifolia ;
    dct:identifier "working-eco-wp-08a" ;
    rdfs:comment "Single species HMC manifest. Individuals are parameterized by InstanceState64 (seed, ontogenetic_age_norm, height_scale, site_vigor, environmental_stress) plus pipe-model parameters."@en .

bint:OrganismTemplate a rdfs:Class ;
    rdfs:label "Banksia integrifolia L.f. Organism Template"@en ;
    rdfs:comment "Instantiate individual trees via InstanceState64 across stages {coastal_seedling: 0.00-0.15, serrate_sapling: 0.15-0.40, mature_headland_tree: 0.40-0.80, senescent_gnarled_veteran: 0.80-1.00} with Shinozaki exponent 2.49, pseudowhorled fork angles 38-68 deg, proteoid cluster roots (PO:0025025), lignotuber (PO:0025524), tessellated bark (PO:0004518), pinkish-red medullary-rayed wood density 530 kg/m3, whorled strongly discolorous leaves (silvery-white abaxial underside), cylindrical golden-yellow flower spikes (7-14 cm), and bivalved woody follicular cones."@en .
