    dcat:accessURL <file:dist/taxon.q42> ;
    prov:wasDerivedFrom member:taxon-ttl ;
    prov:wasGeneratedBy <urn:qualia:morphism:synth_compile_q42> ;
    q42:artifactStatus "compiled_q42" .

