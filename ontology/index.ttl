qualia:banksia_integrifolia a dcat:Dataset ;
    owl:sameAs <did:q42:taxon:banksia_integrifolia> ;
    dct:title "Banksia integrifolia L.f. (Coast Banksia) Hypermedia Dataset"@en ;
    dct:description "SE Australian coastal dune & headland Proteaceae keystone flora ontology, proteoid/pipe-model allometry, InstanceState64 ontogeny, and multi-regime Hypermedia (.hmc) production manifest."@en ;
    dct:publisher <https://github.com/intenteco> ;
    dct:spatial "South-Eastern Australia (Coastal Dunes, Headlands & Near-Coastal Sands across NSW and Victoria)" ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    q42:commonsFramework "SPC" ;
    dcat:landingPage <https://github.com/intenteco/banksia-integrifolia> ;
    dct:hasPart member:taxon-ttl ,
                member:taxon-q42 ,
                member:index-ttl ,
                member:index-q42 ,
                member:claims-json ,
                member:bookmarks-json ,
                member:jobs-json ,
                member:planned-vibe-cad ,
                member:planned-actuation-vibe ,
                member:planned-hmc ,
                member:planned-10d ,
                member:planned-substrate-m64 ,
                member:planned-field-emf .

member:taxon-ttl a dcat:Distribution ;
    dct:title "Taxon & Biophysical Ontology Source (Turtle)"@en ;
    dcat:mediaType "text/turtle" ;
    dcat:accessURL <file:ontology/taxon.ttl> ;
    q42:artifactStatus "authored" .

