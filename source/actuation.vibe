        { id: "root_plate_sinker", position: [4.80, -0.85, 0.60], velocity: [0.0, 0.0, 0.0], radius: 0.25, inv_mass: 0.02 },
        { id: "primary_bough_sway", position: [5.40, 10.10, -1.35], velocity: [coastal_wind.bough_amplitude_rad, 0.03, -0.09], radius: 0.10, inv_mass: 0.62 },
        { id: "whorl_sprig_silver_flash", position: [6.20, 13.15, 1.35], velocity: [coastal_wind.leaf_flutter_amplitude_rad, -0.03, 0.14], radius: 0.65, inv_mass: 1.05 }
    ],
    area_override: {
